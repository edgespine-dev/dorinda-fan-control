# Copy to secrets.env (gitignored). Required for: make test2-upload
#
# Dorinda has no boat router — default is AP mode: ESP creates its own WiFi,
# phone joins that network and opens http://192.168.4.1/
#
# WIFI_MODE=AP   → soft AP (boat / offline)
# WIFI_MODE=STA  → join existing network (home bench)

WIFI_MODE=AP
WIFI_SSID=Dorinda-Fan
WIFI_PASSWORD=change_me_8
